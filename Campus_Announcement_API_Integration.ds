ent'\n\t\ttarget = 'new-window'\n\n\tcolor = '#6733AB'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Add New Announcement'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel_Button 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#8A3DFB'\n\n\t\twidth = '2%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '10px'\n\tpaddingLeft = '10px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '10px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '98%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginRight = '10px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#2C0D4A'\n\tbgColor = '#F4F0FF'\n\twidth = '36px'\n\theight = '36px'\n\ttype = 'icon'\n\tvalue = 'ui-2-square-add-08'\n\tsize = '16px'\n\tcornerRadius = '18px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n>\n\t<text \n    action = 'OpenReport'\n\t\tcomponentLinkName = 'announcement_log_Report'\n\t\ttarget = 'new-window'\n\n\tcolor = '#6733AB'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Show Announcement Log Report'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\t\n\ttitle = 'Action Type by Response Status'\n\t\n\t\ttitleSize = '15px'\n\ttype = 'Bar'\n\txtitle = 'Action Type'\n\tytitle = 'Response Status'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'announcement_log'\n\txfield = 'action_type'\n\tyfields = 'sum:response_status'\n\tgroupBy = 'announcement'\n\t\tDelugeCriteria = 'action_type is not null &amp;&amp; action_type != &quot;&quot;'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 2'\n\n\t\n\ttitle = 'Distribution by Authorized Scope'\n\t\n\t\ttitleSize = '15px'\n\ttype = 'Bar'\n\txtitle = 'Authorized Scope'\n\tytitle = 'Count of Authorized Scope'\n\tbgColor = '#FFFFFF'\n\ttheme = '#198391'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'api_client'\n\txfield = 'authorized_scope'\n\tyfields = 'count:authorized_scope'\n\tgroupBy = 'client_name'\n\t\tDelugeCriteria = 'authorized_scope is not null &amp;&amp; authorized_scope != &quot;&quot;'\n/>\n\n</column>\n</row>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'announcement_log_Report'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_Print = 'false'\n\t\t\t\t\tzc_Export = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_Search = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'custom'\n\theightValue = '500'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			log_api_creation as "Log API Creation"
			{
				type =  form
				form = announcement

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Create a log entry in announcement_log form when a new announcement is created
										// Prepare the log data with current user information
										logData = Map();
										logData.put("announcement",input.ID);
										logData.put("action_type","Create");
										logData.put("action_timestamp",zoho.currenttime);
										// Set user details from the logged-in user
										logData.put("first_name",zoho.loginuser.Name);
										logData.put("last_name",zoho.loginuserid);
										// Insert the log record
										response = insert into announcement_log
										[
											announcement=input.ID
											action_type="Create"
											action_timestamp=zoho.currenttime
											performed_by.first_name=zoho.loginuser.Name
											performed_by.last_name=zoho.loginuserid
											Added_User=zoho.loginuser
										];
										// Send notification email to admin
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :"New Announcement Created: " + input.announcement_title
											message :"A new announcement has been created with title: " + input.announcement_title + ". Message: " + input.message
										]
						)
					}
				}

			}
			validate_urgent_priority as "Validate Urgent Priority"
			{
				type =  form
				form = announcement

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if priority is High
										if(input.priority == "High")
										{
											// Check if Urgent tag is missing in tags field
											if(!input.tags.contains("Urgent"))
											{
												// Display error message to user
												alert "High priority announcements must have the Urgent tag. Please add the Urgent tag to proceed.";
												// Cancel the form submission
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_high_priority as "Notify on High Priority"
			{
				type =  form
				form = announcement

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Check if the announcement priority is High
										if(input.priority == "High")
										{
											// Get the admin user ID
											adminEmail = zoho.adminuserid;
											// Get the announcement title and message
											announcementTitle = input.announcement_title;
											announcementMessage = input.message;
											// Send notification email to admin
											sendmail
											[
												from :zoho.adminuserid
												to :adminEmail
												subject :"High Priority Announcement: " + announcementTitle
												message :"A new high priority announcement has been posted.\n\nTitle: " + announcementTitle + "\n\nMessage: " + announcementMessage
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			auto_set_active_status as "Auto-Set Active Status"
			{
				type =  schedule
				form = announcement
					status = inactive
				start = valid_till at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch announcements where valid_till is before today
										pastDueAnnouncements = announcement[valid_till < today];
										// Iterate through each past-due announcement and deactivate it
										for each  announcementRecord in pastDueAnnouncements
										{
											// Check if the announcement is currently active
											if(announcementRecord.is_active == true)
											{
												// Update the is_active field to false
												announcementRecord.is_active=false;
											}
										}
					)
					}
				}
			}
		}




