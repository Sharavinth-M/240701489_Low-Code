 application "Campus Announcement API Integration"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form announcement
		{
			displayname = "Announcement"
			success message = "Announcement Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			announcement_title
			(
    			type = text
				displayname = "Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			message
			(
    			type = textarea
				displayname = "Message"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = picklist
				displayname = "Category"
				values = {"Placement","Event","Academic"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			valid_till
			(
    			type = date
				displayname = "Valid Till"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			posted_by
			(
    			type = name
				displayname = "Posted By"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			reference_code
			(
    			type = text
				displayname = "Reference Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority
			(
				type = picklist
				displayname = "Priority"
				values = {"High","Low","Medium"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			display_order
			(
				type = number
				displayname = "Display Order"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			tags
			(
				type = list	
				displayname = "Tags"
				values = {"Urgent","Important","General","Confidential"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Draft Created","Pending Review","Archived","Published","Expired"}
			}
		}
		form announcement_log
		{
			displayname = "Announcement Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			announcement
			(
				type = list	
				displayname = "Announcement"
				values  = announcement.ID
    			displayformat = [announcement_title]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			action_type
			(
				type = picklist
				displayname = "Action Type"
				values = {"Delete","Create","Update"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			performed_by
			(
    			type = name
				displayname = "Performed By"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			action_timestamp
			(
    			type = datetime
				displayname = "Action Timestamp"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_payload
			(
    			type = textarea
				displayname = "Request Payload"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			response_status
			(
				type = number
				displayname = "Response Status"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			error_message
			(
    			type = textarea
				displayname = "Error Message"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			ip_address
			(
    			type = text
				displayname = "IP Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form api_client
		{
			displayname = "API Client"
			success message = "Api Client Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			client_name
			(
    			type = text
				displayname = "Client Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			client_code
			(
    			type = text
				displayname = "Client Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			authorized_scope
			(
    			type = text
				displayname = "Authorized Scope"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_registered
			(
    			type = checkbox
				displayname = "Is Registered"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			token_expiry
			(
    			type = datetime
				displayname = "Token Expiry"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_accessed
			(
    			type = datetime
				displayname = "Last Accessed"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			access_level
			(
				type = picklist
				displayname = "Access Level"
				values = {"Read","Write","Full"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Registration Initiated","Pending Validation","Registration Rejected","Active","Token Expiring","Suspended","Deactivated"}
			}
		}
	}
	reports
	{
		list announcement_log_Report
		{
			displayName = "Announcement Log Report"
			show all rows from announcement_log    
			(
				announcement as "Announcement"
				action_type as "Action Type"
				performed_by  as "Performed By"
				action_timestamp as "Action Timestamp"
				request_payload as "Request Payload"
				response_status as "Response Status"
				error_message as "Error Message"
				ip_address as "IP Address"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (action_type == "Create")
				fields = [action_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (action_type == "Update")
				fields = [action_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban announcement_log_by_action_type
		{
			displayName = "Action Types"
			show all rows from announcement_log    
			(
				announcement as "Announcement"
				action_type as "Action Type"
				performed_by  as "Performed By"
				action_timestamp as "Action Timestamp"
				request_payload as "Request Payload"
				response_status as "Response Status"
				error_message as "Error Message"
				ip_address as "IP Address"
			)
			options
			(
	 			display field = action_type
	 		)
		}
		list api_client_Report
		{
			displayName = "All Api Clients"
			show all rows from api_client    
			(
				client_name as "Client Name"
				client_code as "Client Code"
				authorized_scope as "Authorized Scope"
				is_registered as "Is Registered"
				token_expiry as "Token Expiry"
				last_accessed as "Last Accessed"
				access_level as "Access Level"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (access_level == "Read")
				fields = [access_level]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (access_level == "Write")
				fields = [access_level]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban api_client_by_access_level
		{
			displayName = "Access Levels"
			show all rows from api_client    
			(
				client_name as "Client Name"
				client_code as "Client Code"
				authorized_scope as "Authorized Scope"
				is_registered as "Is Registered"
				token_expiry as "Token Expiry"
				last_accessed as "Last Accessed"
				access_level as "Access Level"
			)
			options
			(
	 			display field = access_level
	 		)
		}
		list announcement_Report
		{
			displayName = "All Announcements"
			show all rows from announcement    
			(
				announcement_title as "Title"
				message as "Message"
				category as "Category"
				valid_till as "Valid Till"
				posted_by  as "Posted By"
				reference_code as "Reference Code"
				priority as "Priority"
				is_active as "Is Active"
				display_order as "Display Order"
				tags as "Tags"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (category == "Academic")
				fields = [category]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (category == "Placement")
				fields = [category]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban announcement_by_category
		{
			displayName = "Categories"
			show all rows from announcement    
			(
				announcement_title as "Title"
				message as "Message"
				category as "Category"
				valid_till as "Valid Till"
				posted_by  as "Posted By"
				reference_code as "Reference Code"
				priority as "Priority"
				is_active as "Is Active"
				display_order as "Display Order"
				tags as "Tags"
			)
			options
			(
	 			display field = category
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='75%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='26%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#5A3D9B'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '0px'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\n\tcolor = '#FFFFFF'\n\tbgColor = '#9B69FB'\n\twidth = '52px'\n\theight = '52px'\n\ttype = 'icon'\n\tvalue = 'shopping-basket-edit'\n\tsize = '22px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '12px'\n\tcolor = '#FFFFFF'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'action_type == &quot;Delete&quot;'\n\t  value = 'thisapp.announcement_log.action_type.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '5px'\n\tcolor = '#FFFFFF'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Count of Delete'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='26%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#734AD0'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '0px'\n\n\t\thAlign = 'left'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '0px'\n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#9B69FB'\n\twidth = '52px'\n\theigh